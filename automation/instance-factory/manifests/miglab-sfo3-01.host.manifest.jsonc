{
  "schemaVersion": 1,
  "host": {
    "provider": "digitalocean",
    "hostname": "miglab-sfo3-01",
    "region": "sfo3",
    "size": "s-2vcpu-4gb",
    "image": "ubuntu-24-04-x64",
    "tags": ["remotelab", "miglab", "owner"],
    "repoGitUrl": "https://github.com/Ninglo/remotelab.git",
    "repoCheckoutPath": "/opt/remotelab",
    "sshUser": "root"
  },
  "network": {
    "listenPort": 7690,
    "ownerDomain": "miglab.jiujianian.dev",
    "ingress": {
      "provider": "cloudflare",
      "tunnelId": "b5d054b5-78dd-45af-8863-3aa9d0945447",
      "tunnelName": "miglab-sfo3-owner",
      "serviceName": "cloudflared-miglab",
      "ownerHostname": "miglab.jiujianian.dev",
      "credentialsFile": "/etc/cloudflared/b5d054b5-78dd-45af-8863-3aa9d0945447.json",
      "localCredentialsFile": "/root/.cloudflared/b5d054b5-78dd-45af-8863-3aa9d0945447.json"
    }
  },
  "systemd": {
    "ownerUnit": "remotelab",
    "logDir": "/var/log/remotelab"
  }
}
